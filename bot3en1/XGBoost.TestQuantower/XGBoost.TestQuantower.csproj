       et joue des journees reelles, transaction par transaction, pour comparer ses ordres au rejeu verifie du moteur. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\XGBoost.Core\*.cs" />
    <Compile Include="..\Bot3en1.Core\Calendrier.cs" />
    <Compile Include="..\XGBoost.Quantower\*.cs" />
    <Compile Include="..\Bot3en1.TestQuantower\Stubs.cs" />
    <EmbeddedResource Include="..\XGBoost.Core\modele_xgb.json" LogicalName="modele_xgb.json" />
  </ItemGroup>
</Project>
