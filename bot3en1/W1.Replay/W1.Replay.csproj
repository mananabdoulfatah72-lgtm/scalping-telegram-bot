<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rejeu du moteur W1 sur des minutes historiques : chaque signal du Supertrend, ses 28 variables, la probabilite du modele
       et la decision (pris / ecarte) comparees a ml/arene/w1_prod.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\W1.Core\*.cs" />
    <EmbeddedResource Include="..\W1.Core\modele_w1.json" LogicalName="modele_w1.json" />
  </ItemGroup>
</Project>
